{
  "name": "Brėžly - AutoCAD praktika",
  "short_name": "Brėžly",
  "description": "AutoCAD praktikos užduotys inžinerijos studentams su brėžinio tikrinimu ir XP.",
  "lang": "lt",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#0d1117",
  "theme_color": "#10151c",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/dxf": [
          ".dxf"
        ],
        "image/vnd.dxf": [
          ".dxf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Pamokos",
      "url": "./#/pamokos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Praktika",
      "url": "./#/praktika",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "categories": [
    "education"
  ]
}